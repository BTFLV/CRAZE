{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CRAZE",
  "version": "2.0.0",
  "identifier": "de.craze.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CRAZE",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "2D resistance simulation for thin-film layouts",
    "copyright": "Copyright (c) 2026 Philip Mohr",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../examples/": "examples/"
    }
  }
}